{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " :: "
  },
  "modules": [
    "title",
    "break",
    {
      "type": "custom",
      "format": "┌───────────── hardware ─────────────┐"
    },
    "break",
    {
      "type": "memory",
      "key": "  󰍛"
    },
    {
      "type": "battery",
      "key": "  󰁹",
      "format": "{capacity} · {time-formatted} left"
    },
    "break",
    {
      "type": "custom",
      "format": "├───────────── software ─────────────┤"
    },
    "break",
    {
      "type": "os",
      "key": "  ",
      "format": "{name} {version}"
    },
    {
      "type": "wm",
      "key": "  ",
      "format": "{plugin-name}"
    },
    {
      "type": "terminal",
      "key": "  ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "  ",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "  󰅐"
    },
    "break",
    {
      "type": "custom",
      "format": "└────────────────────────────────────┘"
    }
  ]
}
